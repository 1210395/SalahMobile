# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# ── عمارتي project-specific ──
# Composer binary (install Composer instead; see backend/README.md)
composer.phar
composer-setup.php
# Local web review artifacts
.playwright-mcp/
0*.png
[0-9][0-9]-*.png
# Flutter Dart tooling
.flutter-plugins
v[0-9]*.png

# Never commit backend backup snapshots
backend-backup-*/

# Playwright run artifacts (screenshots, traces, error contexts)
test-results/
e2e/test-results/

# Build logs (the *.log pattern above doesn't catch the .txt variant)
build_log.txt

# Release signing — the keystore and its passwords never enter the repo.
/android/key.properties
*.jks
*.keystore
